# GEMINI_API_KEY: Required for Gemini AI API calls.
GEMINI_API_KEY="your-gemini-api-key"

# GROQ_API_KEY: High-speed inference for Llama/Qwen/GPT-OSS models
GROQ_API_KEY="your-groq-api-key"

# OPENROUTER_API_KEY: Unified multi-model frontier routing
OPENROUTER_API_KEY="your-openrouter-api-key"

# DEEPSEEK_API_KEY: Optional DeepSeek direct API
DEEPSEEK_API_KEY="your-deepseek-api-key"
DEEPSEEK_BASE_URL="https://api.deepseek.com/chat/completions"

# APP_URL: The URL where this platform is hosted.
APP_URL="https://dezo.in"

# DEZO Master Platform Security Secret
DEZO_MASTER_SECURITY_SECRET="your-base64-or-hex-master-secret"
INTERNAL_REPORTING_SECRET="optional-bearer-token-for-reporting-api"

# InsForge public client credentials (Vite)
VITE_INSFORGE_URL="https://your-appkey.us-east.insforge.app"
VITE_INSFORGE_ANON_KEY="ik_your_anon_key"

# Google Search Console Verification (HTML meta tag fallback)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION="your-google-site-verification-token"

# Google Analytics 4 (Consent-aware measurement ID)
NEXT_PUBLIC_GA_MEASUREMENT_ID=""

# Google Search Console API Reporting (Server-side only — never exposed to client)
GOOGLE_SEARCH_CONSOLE_CLIENT_EMAIL="gsc-reporter@your-gcp-project.iam.gserviceaccount.com"
GOOGLE_SEARCH_CONSOLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_SEARCH_CONSOLE_SITE_URL="sc-domain:dezo.in"
